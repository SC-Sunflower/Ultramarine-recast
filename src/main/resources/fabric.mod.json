{
  "schemaVersion": 1,
  "id": "${mod_id}",
  "version": "${mod_version}",
  "name": "${mod_name}",
  "description": "${mod_description}",
  "authors": [
    "Soul_Shadow",
    "LocusAzzurro",
    "Flechazo"
  ],
  "contact": {
    "homepage": "${mod_display_url}",
    "sources": "${mod_display_url}",
    "issues": "${mod_issue_tracker}"
  },
  "license": "${mod_license}",
  "icon": "ultramarine_logo.png",
  "environment": "*",
  "entrypoints": {
    "client": [
      "com.voxelutopia.ultramarine.UltramarineClient"
    ],
    "main": [
      "com.voxelutopia.ultramarine.Ultramarine"
    ],
    "fabric-datagen": [
      "com.voxelutopia.ultramarine.data.ModDataGenerator"
    ]
  },
  "mixins": [
    "ultramarine.mixins.json"
  ],
  "accessWidener": "ultramarine.accesswidener",
  "depends": {
    "fabricloader": ">=0.15.7",
    "fabric-api": "*",
    "minecraft": ">=1.20.5 <1.20.7",
    "java": ">=21"
  }
}
